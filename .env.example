# MAILTRACE AI — local development template
APP_NAME="MAILTRACE AI"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=false
SECRET_KEY="replace-with-a-long-random-development-secret"
DATABASE_URL="sqlite:///./mailtrace.db"
MODEL_PATH="ml/models/dataset3_v1.0.0"
ML_MODEL_PATH="ml/models/dataset3_v1.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Gmail OAuth — keep real values in your ignored local .env only.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/auth/google/callback"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.settings.basic"

# Optional Gmail push notifications via Google Cloud Pub/Sub.
GOOGLE_CLOUD_PROJECT=""
GMAIL_PUBSUB_TOPIC=""
GOOGLE_PUBSUB_TOPIC=""

# Frontend value is read from frontend/.env, not backend .env.
EXPO_PUBLIC_API_URL="http://127.0.0.1:8000"
